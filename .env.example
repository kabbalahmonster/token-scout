# Safe local defaults. Generate a long random token before any non-local deployment.
NODE_ENV=development
HOST=127.0.0.1
API_PORT=3001
WEB_PORT=4173
DATABASE_PATH=./data/doomscout.db
# Non-secret local placeholder so Compose can boot. Replace before any public/TLS deployment.
AUTH_TOKEN=change-me-before-public-deployment-0000000000000000
PUBLIC_READ=false
TRUST_PROXY=false
LOG_LEVEL=info

CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
DEXSCREENER_API_URL=https://api.dexscreener.com
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
COINGECKO_API_URL=https://api.coingecko.com/api/v3
SUSHI_QUOTE_URL=https://api.sushi.com/quote/v7/4663
WRAPPED_NATIVE_ADDRESS=

DISCOVERY_INTERVAL_SECONDS=900
DISCOVERY_TOP_PAGES=5
DISCOVERY_NEW_PAGES=2
DISCOVERY_MIN_LIQUIDITY_USD=1000
DISCOVERY_MIN_VOLUME_24H_USD=100
DISCOVERY_MIN_TRANSACTIONS_24H=2
HISTORY_BACKFILL_HOURS=168
WATCHED_POLL_SECONDS=60
EXPECTED_POLL_SECONDS=60
ADAPTER_TIMEOUT_MS=8000
ADAPTER_RETRIES=2
ADAPTER_CACHE_SECONDS=30
PLANNED_BUDGET_WEI=100000000000000000
POSITION_COUNT=4
SWING_THRESHOLDS=0.02,0.05,0.10,0.20
SWING_CONFIRMATION_SAMPLES=1
SWING_MIN_SEPARATION_SECONDS=60
RAW_RETENTION_DAYS=7
CANDLE_RETENTION_DAYS=90
HOURLY_RETENTION_DAYS=730
