# Bind Compose to 127.0.0.1 and let Caddy own public ports 80/443.
# Replace scout.example.com and keep AUTH_TOKEN set in .env.
scout.example.com {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8080
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Frame-Options DENY
    X-Content-Type-Options nosniff
  }
}
